# ==============================================================================
# Friply / vinted-api Environment Configuration
# Copy this file to .env before running docker compose:
#   cp .env.example .env
# ==============================================================================

# Network bindings (default localhost for security)
BIND_HOST=127.0.0.1
BACKEND_PORT=3000
FRONTEND_PORT=5000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vinted

# Vinted session mode:
# - playwright: automatically bootstraps an anonymous session (recommended)
# - static: uses manually supplied VINTED_* values below
VINTED_SESSION_MODE=playwright
VINTED_LOCALE=fr-FR
VINTED_ORDER=relevance

# Static session fallback (only needed if VINTED_SESSION_MODE=static)
VINTED_COOKIE=
VINTED_CSRF_TOKEN=
VINTED_ANON_ID=

# Telegram notifications (optional)
# Create a bot with @BotFather to get TELEGRAM_BOT_TOKEN
# Send a message to the bot, then get your chat ID via:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DEFAULT_PROFILE_NAME=Default
TELEGRAM_ENABLE_COMMANDS=false
TELEGRAM_CLEAR_LIMIT=50
