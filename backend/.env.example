PORT=3000
HOST=0.0.0.0

# Session mode:
# - playwright: bootstraps an anonymous session automatically (recommended)
# - static: uses the VINTED_* values below (manual)
VINTED_SESSION_MODE=playwright

# Optional but often required for Vinted web API access (Cloudflare / anti-bot).
# Use curl.md as the source of truth and paste values from a real browser session if you use static mode.
VINTED_LOCALE=fr-FR
VINTED_ANON_ID=
VINTED_CSRF_TOKEN=
VINTED_COOKIE=

# Defaults used by the proxy request (based on curl.md)
VINTED_PER_PAGE=96
VINTED_ORDER=relevance

# Playwright bootstrap settings
VINTED_BOOTSTRAP_URL=https://www.vinted.fr/
VINTED_BOOTSTRAP_SEARCH_TEXT=jeans
VINTED_BOOTSTRAP_TIMEOUT_MS=30000
VINTED_SESSION_REFRESH_COOLDOWN_MS=60000
